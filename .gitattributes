# Explicitly exclude the dashboard HTML file from language statistics
dashboard.html linguist-vendored
dashboard.html linguist-generated
dashboard.html -linguist-detectable

# Wildcard fallback for all other HTML files anywhere in repo
*.html linguist-vendored
*.html linguist-generated
*.html -linguist-detectable
*/**.html linguist-vendored
*/**.html linguist-generated
*/**.html -linguist-detectable

# Assets and documentation
assets/** linguist-vendored
results/figures/** linguist-vendored
